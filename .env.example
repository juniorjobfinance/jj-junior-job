# Modèle des identifiants attendus par le pipeline.
# Copier en `.env` pour un usage local ; en production, ces valeurs sont des
# secrets GitHub Actions (Settings > Secrets and variables > Actions).
# Ne JAMAIS committer le fichier `.env` lui-même.

# France Travail — API Offres d'emploi v2 (francetravail.io)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Adzuna (developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# La Bonne Alternance (api.apprentissage.beta.gouv.fr)
LBA_API_TOKEN=
