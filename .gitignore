# Secrets — ne JAMAIS publier
.env
.env.*
!.env.example

# Généré par le pipeline
ingestion/state.json

# Divers
node_modules/
*.log

# Journaux des passages quotidiens
journaux/
ingestion/cache-avature.json
# Magasin des récoltes : reconstruit à chaque passage, gardé entre deux par
# le cache GitHub Actions. Trop volumineux et trop mouvant pour le dépôt.
ingestion/cache-recoltes.json.gz

# Fichiers de travail du sourcing : jamais publiés, ils seraient servis
# publiquement par l'hébergeur statique.
detection*.txt
sonde-*.txt
portails.txt
*.log
swagger*.json

# Pages de mise au point récupérées pendant l'analyse des ATS
am2.html
amjob.html
ey2.html
eyjob.html

# Configuration locale de l'éditeur
.claude/

# Les photos de collecte : gros, quotidiennes, et regenerables. La rotation
# en supprime une chaque jour — suivies par git, elles font grossir le depot
# et polluent chaque passage avec une suppression non commitee.
data/brut-*.json
data/brut-*.json.gz

# Le corps de l issue « Maisons a inscrire » : regenere a chaque passage.
data/maisons-a-inscrire.md
